AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=lumina-rec-recommender

LUMINA_API_KEY=local-dev-api-key
LUMINA_RATE_LIMIT=300/minute

# Required. Must match a run in the current local MLflow/MinIO volumes.
# After training, copy values from reports/latest_training_run.json.
MODEL_RUN_ID=replace_with_mlflow_run_id
MODEL_SHA256=replace_with_approved_model_sha256
MODEL_ARTIFACT_PATH=approved_model

USE_MODEL_REGISTRY=false
REGISTERED_MODEL_NAME=lumina-rec-movielens-mf
MODEL_ALIAS=approved
